# --- Supabase (Cloud) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser, never paste in chats.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (server only; the browser gets a short-lived ephemeral token) ---
# Rotate the key that was pasted in chat before using it here.
GEMINI_API_KEY=
# The Live model id that passed the Nov 3 test (Gemini 3.1 Flash Live).
GEMINI_LIVE_MODEL=
# Optional prebuilt voice name
GEMINI_LIVE_VOICE=
